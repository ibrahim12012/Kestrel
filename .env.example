# Copy this file to .env and fill in what you need.
#
# Every key here is yours. This app ships no key of its own, proxies
# nothing through anyone else's server, and has no account to sign in to.
# Keys entered in Settings are stored in your OS credential store rather
# than here; this file is the fallback for a machine without one, and
# for CI.

# ── API keys ─────────────────────────────────────────────────────────
# Only the provider(s) you actually pick in the chat's model dropdown.
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only if your local server wants one; most do not.
LOCAL_API_KEY=

# ── Crash reporting (optional, off unless you opt in from Settings) ──
# See docs/TELEMETRY_SETUP.md for getting a Sentry DSN.
SENTRY_DSN=
KESTREL_TELEMETRY_ENABLED=0

# ── Update checks (optional) ─────────────────────────────────────────
# "owner/repo" of a public GitHub repo whose Releases to check against.
# Blank uses the project's own (branding.DEFAULT_UPDATE_REPO); set this
# only for a fork. The check needs a published GitHub Release to find,
# not just a tag.
APP_UPDATE_REPO=

# ── Project site (optional) ──────────────────────────────────────────
# Only for a fork that serves its own.
KESTREL_WEBSITE_URL=
