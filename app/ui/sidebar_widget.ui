   <string notr="true">
QWidget#SidebarWidget {
    background-color: #0a0a0a;
    border-right: 1px solid #1a1a1a;
}
QPushButton#btnNewChat,
QPushButton#btnActions,
QPushButton#btnRecorder,
QPushButton#btnMapping,
QPushButton#btnSearch {
    background-color: transparent;
    color: #9a9a9a;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    text-align: left;
    padding: 9px 10px;
    border: none;
    border-radius: 8px;
}
QPushButton#btnNewChat:hover,
QPushButton#btnActions:hover,
QPushButton#btnRecorder:hover,
QPushButton#btnMapping:hover,
QPushButton#btnSearch:hover {
    background-color: #161616;
    color: #f2f2f2;
}
QPushButton#btnNewChat:checked,
QPushButton#btnActions:checked,
QPushButton#btnRecorder:checked,
QPushButton#btnMapping:checked,
QPushButton#btnSearch:checked {
    background-color: rgba(124,106,255,0.12);
    color: #f2f2f2;
    border-left: 3px solid #7c6aff;
    padding-left: 7px;
}
QLabel#sectionLabel, QLabel#sectionLabelOld {
    color: #5c5c5c;
    font-family: &quot;Syne&quot;;
    font-size: 10px;
    font-weight: 500;
    background: transparent;
    padding: 10px 8px 6px;
}
QScrollArea#chatHistoryScroll {
    background: transparent;
    border: none;
}
QScrollBar:vertical {
    background: transparent;
    width: 4px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #232323;
    border-radius: 2px;
    min-height: 20px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QFrame#divider1, QFrame#divider2 {
    color: #161616;
    background-color: #161616;
    max-height: 1px;
    border: none;
}
QWidget#bottomArea {
    background-color: #0a0a0a;
    border-top: 1px solid #1a1a1a;
}
QLabel#userName {
    color: #f2f2f2;
    font-family: &quot;Syne&quot;;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}
QLabel#userAvatar {
    background-color: #1e1e1e;
    color: #f2f2f2;
    font-family: &quot;Syne&quot;;
    font-size: 11px;
    font-weight: 700;
    border: 1px solid #2e2e2e;
    border-radius: 14px;
    min-width: 28px; max-width: 28px;
    min-height: 28px; max-height: 28px;
    qproperty-alignment: AlignCenter;
}
QPushButton#btnSettings {
    background-color: transparent;
    color: #9a9a9a;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    text-align: left;
    padding: 9px 10px;
    border: none;
    border-radius: 8px;
}
QPushButton#btnSettings:hover {
    background-color: #161616;
    color: #f2f2f2;
}
