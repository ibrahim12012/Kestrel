  <property name="styleSheet">
   <string notr="true">
/* ── Base ── */
QWidget#ChatWidget {
    background-color: #0a0a0a;
}

/* ── Topbar ── */
QWidget#topbar {
    background-color: #0a0a0a;
    border-bottom: 1px solid #1a1a1a;
    min-height: 52px;
    max-height: 52px;
}
QLabel#chatTitle {
    color: #f2f2f2;
    font-family: &quot;Syne&quot;;
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}

QPushButton#btn_archive {
    background-color: transparent;
    color: #5c5c5c;
    border: 1px solid transparent;
    border-radius: 7px;
    min-width: 32px;
    max-width: 32px;
    min-height: 32px;
    max-height: 32px;
    font-size: 14px;
}

QPushButton#btn_archive:hover {
    background-color: #161616;
    color: #f2f2f2;
    border-color: #1f1f1f;
}

/* ── Messages scroll area ── */
QScrollArea#messagesScroll {
    background-color: #0a0a0a;
    border: none;
}
QScrollArea#messagesScroll &gt; QWidget &gt; QWidget {
    background-color: #0a0a0a;
}
QScrollBar:vertical {
    background: transparent;
    width: 5px;
}
QScrollBar::handle:vertical {
    background: #232323;
    border-radius: 2px;
    min-height: 24px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

/* ── Message bubbles ── */
QWidget#msgRowUser,
QWidget#msgRowAi {
    background: transparent;
}
QWidget#msgRowUser:hover,
QWidget#msgRowAi:hover {
    background-color: rgba(255,255,255,0.015);
}

QLabel#bubbleAi {
    background-color: transparent;
    color: #f2f2f2;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    border: 1px solid #1a1a1a;
    border-radius: 4px 12px 12px 12px;
    padding: 12px 16px;
}
QLabel#bubbleUser {
    background-color: #161616;
    color: #f2f2f2;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    border: 1px solid #1f1f1f;
    border-radius: 12px 4px 12px 12px;
    padding: 12px 16px;
}

/* ── Typing indicator ── */
QWidget#typingIndicator {
    background-color: transparent;
    border: 1px solid #1a1a1a;
    border-radius: 4px 12px 12px 12px;
    padding: 12px 16px;
    max-width: 80px;
}

/* ── Input area ── */
QWidget#inputArea {
    background-color: #0a0a0a;
    border-top: 1px solid #1a1a1a;
    max-height: 240px;
}
QWidget#inputWrapper {
    background-color: #121212;
    border: 1px solid #1f1f1f;
    border-radius: 14px;
}
QWidget#inputWrapper:focus-within {
    border-color: #3a3a3a;
}
QPlainTextEdit#chatInput {
    background-color: transparent;
    color: #f2f2f2;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
    border: none;
    padding: 0px;
    selection-background-color: rgba(124,106,255,0.35);
}
QPlainTextEdit#chatInput::placeholder {
    color: #5c5c5c;
}
QPushButton#sendBtn {
    background-color: #7c6aff;
    color: #ffffff;
    border: none;
    border-radius: 9px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    font-size: 16px;
    font-weight: 700;
}
QPushButton#sendBtn:hover {
    background-color: #8f7dff;
}
QPushButton#sendBtn:pressed {
    background-color: #6a58e0;
}
QPushButton#micBtn {
    background-color: transparent;
    color: #9a9a9a;
    border: 1px solid #232323;
    border-radius: 9px;
    min-width: 34px;
    max-width: 34px;
    min-height: 34px;
    max-height: 34px;
    font-size: 15px;
}
QPushButton#micBtn:hover {
    background-color: #161616;
    color: #f2f2f2;
    border-color: #3a3a3a;
}
QPushButton#micBtn:checked {
    background-color: rgba(214,69,69,0.15);
    color: #e57373;
    border-color: rgba(214,69,69,0.4);
}

/* ── Input tools ── */
QPushButton#tool_join,
QPushButton#tool_no_code,
QPushButton#tool_flow {
    background-color: transparent;
    color: #5c5c5c;
    font-family: &quot;Segoe UI&quot;;
    font-size: 11px;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 10px;
}
QPushButton#tool_join:hover,
QPushButton#tool_no_code:hover,
QPushButton#tool_flow:hover {
    background-color: #161616;
    color: #9a9a9a;
    border-color: #1f1f1f;
}
QLabel#inputHint {
    color: #5c5c5c;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10px;
    background: transparent;
}
