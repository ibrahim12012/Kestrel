   <!-- Search input -->
   <item>
    <widget class="QLineEdit" name="searchInput">
     <property name="placeholderText">
      <string>Search macros…</string>
     </property>
    </widget>
   </item>

   <!-- Filter dropdown (app/styled_dropdown.py::StyledDropdown) is built
        and inserted here at runtime, in MacrosWidget.__init__ - see that
        file's comment for why this is a custom-drawn popup rather than a
        QComboBox: the previous filterCombo QComboBox couldn't be fully
        reskinned via QSS (native popup chrome, square corners, mismatched
        arrow), which is the same reason chat_widget.py's model picker and
        settings_widget.py's theme picker already use StyledDropdown
        instead of a plain QComboBox. -->

  </layout>
 </widget>
</item>

