<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MacrosWidget</class>
 <widget class="QWidget" name="MacrosWidget">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>700</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Macros</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
/* ── Base ── */
QWidget#MacrosWidget {
    background-color: #0a0a0a;
}

/* ── Topbar ── */
QWidget#topbar {
    background-color: #0a0a0a;
    border-bottom: 1px solid #1a1a1a;
    min-height: 52px;
    max-height: 52px;
}
QLabel#pageTitle {
    color: #f2f2f2;
    font-family: "Syne";
    font-size: 14px;
    font-weight: 600;
    background: transparent;
}
QLabel#toolCount {
    color: #9a9a9a;
    font-family: "Segoe UI";
    font-size: 11px;
    background: transparent;
    padding: 2px 8px;
    border: 1px solid #262626;
    border-radius: 8px;
}
QPushButton#btnRefresh, QPushButton#btnRecordMacro {
    background-color: transparent;
    color: #5c5c5c;
    border: 1px solid #1f1f1f;
    border-radius: 7px;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px;
}
QPushButton#btnRefresh:hover, QPushButton#btnRecordMacro:hover {
    background-color: #161616;
    color: #f2f2f2;
    border-color: #3a3a3a;
}

/* ── Filter / Search bar ── */
QWidget#filterBar {
    background-color: #0a0a0a;
    border-bottom: 1px solid #161616;
    min-height: 56px;
    max-height: 56px;
}
QLineEdit#searchInput {
    background-color: #121212;
    color: #f2f2f2;
    font-family: "Segoe UI";
    font-size: 12px;
    border: 1px solid #1f1f1f;
    border-radius: 8px;
    padding: 6px 12px;
    min-height: 32px;
    max-height: 32px;
    selection-background-color: rgba(255,255,255,0.18);
}
QLineEdit#searchInput:focus {
    border-color: #3a3a3a;
}
/* ── Scroll area ── */
QScrollArea#macrosScroll {
    background-color: #0a0a0a;
    border: none;
}
QScrollArea#macrosScroll > QWidget > QWidget {
    background-color: #0a0a0a;
}
QScrollBar:vertical {
    background: transparent;
    width: 5px;
}
QScrollBar::handle:vertical {
    background: #232323;
    border-radius: 2px;
    min-height: 24px;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

/* ── Macro cards ── */
QWidget#macroCard {
    background-color: #121212;
    border: 1px solid #1f1f1f;
    border-radius: 10px;
}
QWidget#macroCard:hover {
    border-color: #3a3a3a;
    background-color: #151515;
}
QLabel#macroName {
    color: #f2f2f2;
    font-family: "Segoe UI";
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}
QLabel#badgeAI {
    color: #b7acff;
    font-family: "Segoe UI";
    font-size: 9px;
    font-weight: 700;
    background-color: rgba(124,106,255,0.12);
    border: 1px solid rgba(124,106,255,0.4);
    border-radius: 4px;
    padding: 1px 6px;
}
QLabel#badgeUser {
    color: #9a9a9a;
    font-family: "Segoe UI";
    font-size: 9px;
    font-weight: 700;
    background-color: transparent;
    border: 1px solid #2e2e2e;
    border-radius: 4px;
    padding: 1px 6px;
}
QLabel#badgeCustom {
    color: #6e6e6e;
    font-family: "Segoe UI";
    font-size: 9px;
    font-weight: 700;
    background-color: transparent;
    border: 1px solid #232323;
    border-radius: 4px;
    padding: 1px 6px;
}
QLabel#macroDesc {
    color: #5c5c5c;
    font-family: "Segoe UI";
    font-size: 11px;
    background: transparent;
}
QLabel#paramName {
    color: #9a9a9a;
    font-family: "Courier New";
    font-size: 11px;
    background: transparent;
    min-width: 100px;
}
QLabel#paramType {
    color: #5c5c5c;
    font-family: "Courier New";
    font-size: 11px;
    background: transparent;
}
QLineEdit#paramInput {
    background-color: #0a0a0a;
    color: #f2f2f2;
    font-family: "Segoe UI";
    font-size: 12px;
    border: 1px solid #1f1f1f;
    border-radius: 6px;
    padding: 4px 10px;
    min-height: 26px;
    max-height: 26px;
}
QLineEdit#paramInput:focus {
    border-color: #3a3a3a;
}
QPushButton#btnRun {
    background-color: #7c6aff;
    color: #ffffff;
    font-family: "Segoe UI";
    font-size: 12px;
    font-weight: 600;
    border: none;
    border-radius: 7px;
    min-width: 72px;
    max-width: 72px;
    min-height: 30px;
    max-height: 30px;
    padding: 0px 12px;
}
QPushButton#btnRun:hover {
    background-color: #8f7dff;
}
QPushButton#btnRun:pressed {
    background-color: #6a58e0;
}
   </string>
